<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Proposte apprese dall'uso: cronologia delle app aperte, letta solo sul telefono -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Scorrere in giù da Casa apre la tendina delle notifiche -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Impronta o PIN per aprire le app nascoste -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Scheda di Sordina e ri-avvisi -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sordina fuori dall'ottimizzazione della batteria: se Android la addormenta, le notifiche non vengono più smistate -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Non disturbare gestito, solo se scelto -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Riepiloghi e notte dopo un riavvio -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Unico accesso a internet: l'indirizzo di Home Assistant scelto dall'utente -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Posizione approssimativa, solo per il meteo (niente posizione precisa: Sordina non usa il GPS né il nome del Wi-Fi) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Motore delle intenzioni: persone, impegni, timer, chiamate, voce sul telefono -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- In auto: la velocità, per dire "fermati" prima di chiedere il codice dell'allarme (letta solo mentre Sordina è aperta sullo schermo dell'auto) -->
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />
    <!-- Solo per mettere lo sfondo di Sordina anche sulla schermata di blocco, se lo chiedi -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Senza questo Android 9+ ignora in silenzio la richiesta di disinstallare un'app -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <!-- Il lettore di QR di Google (play-services-code-scanner) ha un'attività bloccata in verticale: Play ne deduce
         "schermo verticale obbligatorio" ed esclude tablet, Chromebook e XR. Per Sordina non serve. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <!-- La posizione approssimativa è facoltativa: senza, Sordina funziona lo stesso -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- In auto: le app che navigano e quelle che suonano, da scegliere per i due pulsanti -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <!-- Per sapere se Android Auto è collegato -->
    <queries>
        <provider android:authorities="androidx.car.app.connection" />
    </queries>

    <application
        android:name=".SordinaApp"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_old"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Sordina"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Aggiungi a schermata Home" da un browser: le web app finiscono fra le app.
             Un suo task, sopra il browser: Android la apre con NEW_TASK|CLEAR_TASK, e nel task della Home
             cancellerebbe Sordina e finirebbe dietro al browser. Niente noHistory: chiuderebbe la domanda
             appena qualcosa le passa sopra, prima che tu risponda. -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="true"
            android:taskAffinity="app.sordina.pin"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SordinaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.TickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.ActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.BudgetReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.CalendarReminderReceiver"
            android:exported="false" />

        <!-- Facoltativa: freno istantaneo (anche dei siti frenati: dei browser legge solo la barra dell'indirizzo, mentre sono davanti),
             doppio tocco per spegnere, e una frase scritta per te dove l'app non la accetta da fuori (Assist di Home Assistant,
             la casella di Signal senza inviare): lì legge la finestra di quell'app per pochi secondi. Vedi res/xml/accessibility.xml e access_desc. -->
        <service
            android:name=".service.SordinaAccess"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>
        <!-- Sordina sullo schermo dell'auto (Android Auto): Casa, In sordina, Agenda e Parla -->
        <service
            android:name=".car.SordinaCarService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Le schede vogliono la Car API 6: sotto, Sordina mostra una schermata sola -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <!-- "Impronta sul telefono" dall'auto: chiede l'impronta, apre il codice salvato e torna subito via -->
        <activity
            android:name=".car.CarAuthActivity"
            android:exported="false"
            android:taskAffinity="app.sordina.car"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Gli adesivi delle imprese, da mandare a un'altra app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/files" />
        </provider>
        <!-- Il pacchetto di adesivi di WhatsApp: lo legge solo WhatsApp -->
        <provider
            android:name=".ui.WhatsAppStickers"
            android:authorities="${applicationId}.whatsapp"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />
    </application>
</manifest>
